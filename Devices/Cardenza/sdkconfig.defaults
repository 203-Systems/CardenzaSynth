CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Quad I/O, as the Launcher's bootloader runs the flash (W25Q128JV, IO2 / IO3 wired). The bootloader
# decides how the cache reads the flash, so this matters for a board flashed with ours: in DIO the code
# AMY runs from flash made a block's cost outside the voices about 40% higher (2026-11-05).
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
# 120 MHz, single data rate; the PSRAM on the same bus has to run at the same speed (CONFIG_SPIRAM_SPEED_120M
# below: the S3 has one clock for both). The app tunes the timing at its start, so this holds under the
# Launcher's bootloader too. Against 80 MHz: a block's cost outside the voices 10-20% lower; the full
# stress test ran 20 minutes without a fault (2026-11-05).
CONFIG_ESPTOOLPY_FLASHFREQ_120M=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
# A millisecond tick: the HAL waits for each 8-row band it sends to the screen, and esp_lcd does not
# yield from the transfer's completion, so the waiting task runs at the next tick. At 100 Hz a band
# took 10 ms and the UI drew at under 30 fps (2026-11-05); 0.1.0 shipped with 1000 Hz.
CONFIG_FREERTOS_HZ=1000
# Long file names: the storage protocol uses names such as settings.cfg.bak and <project>.ccproj.
CONFIG_FATFS_LFN_HEAP=y

# AMY runs from flash on both cores: a bigger instruction cache for sound, measured on the board.
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# The chip's 2 MB PSRAM (ESP32-S3R2, quad, on the flash bus), mapped but not given to malloc: the
# firmware adds it to the heap for what asks for it (Library/Memory/Memory.h, Devices/Cardenza/app_main.cpp),
# so driver objects and the audio path stay in internal RAM. ESP-IDF drops SPIRAM_IGNORE_NOTFOUND with the
# .bss in PSRAM (below): a board without PSRAM no longer starts (every Cardenza has it).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_120M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MEMMAP=y

# FAT only on the SD card (512-byte sectors), no wear-levelled FAT in flash: with 4096 every open-file
# slot of the card carried a 4 KB buffer, 27 KB of internal RAM for five slots and the volume.
CONFIG_FATFS_SECTOR_512=y
CONFIG_WL_SECTOR_SIZE_512=y

# The 203 community's presence service: off (the user, 2026-11-23). Nothing of it or of CardenzaHAL's Net is
# linked; the Wi-Fi and TLS settings below only matter when it is on again.
CONFIG_CARDENZA_HAL_PRESENCE=n

# The 203 community while the synth runs (CardenzaHAL's presence service, on by default; the device layer
# tells it what the synth does: Devices/Cardenza/DevicePresence.h). Off in 0.2.1: Wi-Fi took 38.6 KB of
# internal RAM and the synth kept 32 KB for itself, more than the 63-69 KB it left. On again (2026-11-18)
# with the app's object in PSRAM (GrooveApp.cpp), Wi-Fi's own allocations in PSRAM (CardenzaHAL's Net:
# 29.7 KB up), a 24 KB floor and the voices first (DevicePresence.cpp). CardenzaHAL's reference sdkconfig
# for Wi-Fi (its examples/launcher_net), leaner where the synth only asks the community's inbox:
# - the PHY never writes its calibration to the flash (it calibrates at the first Wi-Fi start of a run),
#   and Wi-Fi keeps its settings in RAM: nothing goes to internal flash.
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=n
CONFIG_ESP_WIFI_NVS_ENABLED=n
# - TLS's memory in PSRAM (CardenzaHAL's allocator), the common half of the certificate bundle, and its
#   session resumed from one request to the next (no certificates, no key exchange after the first).
CONFIG_MBEDTLS_CUSTOM_MEM_ALLOC=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS=y
# - Wi-Fi's, lwIP's and the supplicant's .bss (12 KB) and the screen's frame (65 KB, Devices/Cardenza/
#   Device.cpp) in PSRAM; the PSRAM heap starts after them (app_main.cpp). ESP-IDF then needs the PSRAM
#   to start (no SPIRAM_IGNORE_NOTFOUND): every Cardenza has it (ESP32-S3R2).
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# - IRAM stays the synth's (AMY's hot code): Wi-Fi and lwIP run from flash. A station on a home network.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
# - Wi-Fi's buffers are internal RAM (1.6 KB each): 3 static ones (the Launcher has 4 for its downloads;
#   the presence service's answers are a few hundred bytes, 2026-11-18), a few dynamic ones (in PSRAM
#   through CardenzaHAL's Net), no aggregation.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
# - IPv4 only; lwIP's task on core 0 at priority 4: below the UI (5), the voice helper (6) and the
#   sequencer's clock (7) there, so TCP and TLS wait for a free moment instead of delaying the sound.
#   Wi-Fi's own task stays at ESP-IDF's 23 on core 0 (a fraction of a millisecond per beacon or frame).
CONFIG_LWIP_IPV6=n
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_LWIP_TCPIP_TASK_PRIO=4

# The HAL's USB camera: the screen as a lossless stream on the WebUSB interface (Device.cpp presents it, with
# USB audio recording only, within the ESP32-S3's four IN endpoints).
CONFIG_CARDENZA_HAL_USB_CAMERA=y

# The HAL goes back to the Launcher after early crashes in a row; the synth's own recovery (Session/restoring.txt:
# the autosave is skipped at the 4th start after three that did not finish) comes first, so one crash more.
CONFIG_CARDENZA_HAL_CRASH_LOOP_CRASHES=4
