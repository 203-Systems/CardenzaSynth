# This firmware's defaults, after CardenzaHAL's board/sdkconfig.defaults (the board: 16 MB flash in QIO
# at 120 MHz as the Launcher's bootloader runs it, the 2 MB PSRAM at 120 MHz, the 1000 Hz tick the
# display needs, FAT with 512-byte sectors and long names). Devices/Cardenza/CMakeLists.txt lists both.

# The partition table is the HAL's: the 203 Launcher's regions left as the Launcher has them, the
# firmware in ota_0 from 0x170000. Installed through the Launcher, the Launcher's table is used and this
# one never is; flashed directly it never touches the Launcher (CardenzaHAL board/partitions.csv).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="CardenzaHAL/board/partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
# AMY runs from flash on both cores: a bigger instruction cache for sound, measured on the board.
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
# The PSRAM is mapped but not given to malloc: the firmware adds it to the heap for what asks for it
# (Library/Memory/Memory.h, Devices/Cardenza/app_main.cpp), so driver objects and the audio path stay
# in internal RAM.
CONFIG_SPIRAM_USE_MEMMAP=y
