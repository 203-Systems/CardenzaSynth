{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix wiki ci --no-audit --no-fund",
  "buildCommand": "bash tools/learn-build.sh",
  "outputDirectory": "wiki/build",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/deployment.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/community",
      "destination": "https://apps.203.io/community/"
    },
    {
      "source": "/community/:path*",
      "destination": "https://apps.203.io/community/:path*"
    }
  ]
}
