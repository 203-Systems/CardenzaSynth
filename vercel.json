{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix wiki ci --no-audit --no-fund",
  "buildCommand": "bash tools/learn-build.sh",
  "outputDirectory": "wiki/build",
  "routes": [
    {
      "src": "^/(.*)$",
      "has": [{"type": "host", "value": "stage.203.io"}],
      "dest": "https://apps.203.io/community/_site/stage.203.io/$1"
    },
    {
      "src": "^/(.*)$",
      "headers": {"X-Content-Type-Options": "nosniff"},
      "continue": true
    },
    {
      "src": "^/deployment\\.json$",
      "headers": {"Cache-Control": "no-store"},
      "continue": true
    },
    {
      "src": "^/sim$",
      "status": 308,
      "headers": {"Location": "/sim/"}
    },
    {
      "src": "^/sim/$",
      "dest": "/sim/index.html"
    },
    {
      "src": "^/sim/learn/?$",
      "status": 307,
      "headers": {"Location": "/"}
    },
    {
      "src": "^/sim/cardenza\\.wasm$",
      "headers": {"Content-Type": "application/wasm"},
      "continue": true
    },
    {
      "src": "^/community/?$",
      "dest": "https://apps.203.io/community/"
    },
    {
      "src": "^/community/(.*)$",
      "dest": "https://apps.203.io/community/$1"
    }
  ]
}
